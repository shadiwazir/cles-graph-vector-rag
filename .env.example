# Copy to .env and fill in. Never commit .env.

# --- Postgres (no default password: Compose fails if unset) ---
POSTGRES_DB=cles_db
POSTGRES_USER=cles_admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687

# --- LLM provider (extraction and baseline generation) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
OPENAI_API_KEY=
# Must be true to send case text to a third-party generator (public/synthetic cases only).
ALLOW_EXTERNAL_GENERATOR=false

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=auto   # auto | cpu | cuda
EMBEDDING_BATCH_SIZE=32

# --- Project ---
DOMAIN_PACK=legal_ca_on
DATA_DIR=data

# --- Tracking and telemetry ---
MLFLOW_TRACKING_URI=http://localhost:5000
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_CAPTURE_CONTENT=redacted   # none | redacted | full
TELEMETRY_RETENTION_DAYS=30

# --- LLM concurrency and prices (USD per million tokens; look them up, they change) ---
LLM_CONCURRENCY=4
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_TIMEOUT_SECONDS=600   # raise for slow local models

# --- Grafana (observability profile; no default password) ---
GRAFANA_PASSWORD=
