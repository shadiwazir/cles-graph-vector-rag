{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advice",
  "type": "object",
  "required": [
    "case_position",
    "routes",
    "risks",
    "recommended_next_steps",
    "missing_information",
    "evidence_strength"
  ],
  "properties": {
    "case_position": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "expected_outcome",
          "likelihood",
          "reasoning",
          "authorities"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected_outcome": {
            "enum": [
              "appeal_allowed",
              "appeal_dismissed",
              "appeal_allowed_in_part",
              "other"
            ]
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reasoning": {
            "type": "string"
          },
          "authorities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "case_id",
                "para",
                "quote"
              ],
              "properties": {
                "case_id": {
                  "type": "string"
                },
                "para": {
                  "type": "integer"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "expected_remedies": {
            "type": "array",
            "items": {
              "enum": [
                "sentence_increased",
                "sentence_reduced",
                "new_trial_ordered",
                "acquittal_entered",
                "acquittal_set_aside",
                "remitted",
                "order_varied",
                "order_set_aside",
                "leave_to_appeal_granted"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "expected_outcome": {
                  "const": "appeal_dismissed"
                }
              },
              "required": [
                "expected_outcome"
              ]
            },
            "then": {
              "properties": {
                "expected_remedies": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_strength": {
      "enum": [
        "weak",
        "moderate",
        "strong"
      ]
    }
  }
}
