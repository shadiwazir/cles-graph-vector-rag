{
 "uid": "cles-quality",
 "title": "CLES model quality and pipeline",
 "tags": [
  "cles"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Matches the advice schema (latest eval)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "last_over_time(cles_eval_quality{scope=\"all\",metric=\"valid_schema\"}[30d])",
     "legendFormat": "{{system}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
